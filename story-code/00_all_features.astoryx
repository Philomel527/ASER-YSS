校验室来信：21 类控制器与全参数主验收
#useRule:AdvanceRule
#version:2

// 检查编号与预期现象见项目根目录的验收说明。
#aliases
mon3tr(amb2026)->Mon3tr/？？？/校验员
阿米娅(furnace_finale)->阿米娅/访客
#endaliases

#block 提示(text)
校验员	$(text),@BasicStayTime=0.6,@Interval=0.015,@ExtraStayTime=0.015
#endblock

#block 镜头(bg,seconds)
背景：$(bg),@FadeInTime=$(seconds),@StartPosition=0,0,10,@EndPosition=0,0,10,@MoveTime=0,@MoveCurve=Linear,@IsBlocker=true
#endblock

#block 嵌套镜头(bg)
#use 镜头($(bg),0.25)
#use 提示([M18] 内层提示块已展开；这不是运行时函数调用。)
#endblock

#block 曲线演示(curve)
自由文本：曲线：$(curve),@Immediate=true,@SlotIndex=3,@Position=0,3.2,10,@RenderOrder=1000,@StayTime=0,@FadeOutTime=0,@IsBlocker=false
背景：grid_A,@FadeInTime=0,@StartPosition=-2,0,12,@EndPosition=2,0,10,@MoveTime=0.55,@MoveCurve=$(curve),@IsBlocker=true
#endblock

